// if / while / for and when / loop aliases
let n = 0;
if (true) {
  n = 1;
} else {
  n = 2;
}
out(n);

when (n == 1) {
  out(100);
}

let i = 0;
while (i < 3) {
  out(i);
  i = i + 1;
}

let j = 0;
loop (j < 2) {
  out(j + 10);
  j = j + 1;
}

for (let k = 0; k < 3; k = k + 1) {
  out(k + 20);
}

let xs = [7, 8, 9];
for (x in xs) {
  out(x);
}
